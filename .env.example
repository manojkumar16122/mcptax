# Groq: free key at https://console.groq.com/keys (only needed when COMPRESSOR=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low | medium | high. Leave empty to omit.
GROQ_REASONING_EFFORT=low
# groq (LLM rewrite) or heuristic (offline, deterministic)
COMPRESSOR=groq
